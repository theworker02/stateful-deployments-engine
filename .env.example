# SDE environment example (no secrets)

# Local / ENGINE_PROVIDED (default)
# (no Railway vars required)
# Quick path: .\scripts\install.ps1  →  sde doctor  →  sde demo

# Live Railway GraphQL adapter
SDE_RAILWAY_LIVE=0
RAILWAY_TOKEN=
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_SHADOW_SERVICE_ID=
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_ACTIVE_STATE_PATH=
RAILWAY_SHADOW_STATE_PATH=
RAILWAY_STATE_STAGING=
RAILWAY_JOURNAL_DIR=
# RAILWAY_GRAPHQL_URL=https://backboard.railway.com/graphql/v2

# After filling live vars:
#   sde railway status --probe
#   sde doctor --probe
